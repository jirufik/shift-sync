#!/usr/bin/env bash
#
# Проверка перед коммитом: секреты и чужие данные.
#
# Хук лежит в репозитории, а не в `.git/hooks`, и включается один раз командой
#   git config core.hooksPath .githooks
# В новом клоне её надо повторить — об этом сказано в README и в CLAUDE.md.
#
# Обойти проверку можно через `git commit --no-verify`. Это осознанное решение
# и повод объяснить его в сообщении коммита, а не привычка.
set -euo pipefail

node scripts/scan-secrets.mjs --staged
