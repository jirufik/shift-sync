# ─────────────────────────────────────────────────────────────────────────────
#  Shift Sync — шаблон конфигурации
#
#  Скопировать в .env и заполнить. Обязательны к заполнению только два поля:
#  APP_PASSWORD и SESSION_SECRET. Для записи в календарь дополнительно нужен
#  GCAL_CALENDAR_ID и файл ключа сервисного аккаунта.
#
#  Относительные пути считаются от рабочего каталога backend — apps/api (D-019).
#  Подробный разбор каждой переменной — docs/SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4080
LOG_LEVEL=info                        # fatal | error | warn | info | debug | trace

# ── доступ в сервис ──────────────────────────────────────────────────────────
APP_PASSWORD=                         # ЗАПОЛНИТЬ: пароль для входа
SESSION_SECRET=                       # ЗАПОЛНИТЬ: случайная строка, минимум 16 символов
SESSION_TTL_DAYS=30                   # сколько дней живёт сессия
COOKIE_SECURE=false                   # true, если сервис за HTTPS

# ── база данных ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5481                          # не 5432: не мешать локальному PostgreSQL
DB_NAME=fc_shift_sync
DB_USER=fc_admin
DB_PASSWORD=fc_admin
DB_DEBUG=false                        # true — печатать SQL в лог
DB_AUTO_MIGRATE=true                  # применять миграции при старте

# ── хранилище скриншотов ─────────────────────────────────────────────────────
STORAGE_DIR=../../storage/screenshots
SCREENSHOT_RETENTION_DAYS=180         # 0 — удалять сразу после успешного импорта

# ── распознавание ────────────────────────────────────────────────────────────
# Провайдер один и не переключается: PP-OCRv5 через ppu-paddle-ocr (D-004).
# Единственная настройка — до какого размера ужимать кадр перед распознаванием.
# 1280 = родное разрешение скриншотов, без даунскейла. На нём получены 9/9.
OCR_MAX_SIDE_LENGTH=1280

# ── Google Календарь ─────────────────────────────────────────────────────────
# Как получить ключ и ID календаря — docs/SETUP.md, раздел 4.
GOOGLE_SERVICE_ACCOUNT_JSON=../../secrets/service-account.json
GCAL_CALENDAR_ID=                     # ЗАПОЛНИТЬ: ID календаря, куда писать смены
GCAL_TIMEZONE=Europe/Helsinki
GCAL_UPDATE_STRATEGY=update           # update — менять событие на месте | recreate — удалять и создавать
GCAL_EVENT_PREFIX=Работа              # заголовок события: «Работа 08:00–14:00»
GCAL_COLOR_ID=11                      # цвет события в календаре, 1…11
GCAL_APP_TAG=fc-shift-sync            # метка «своих» событий, менять не нужно
